+/// Review 3.0, unit C (red): a confirmed file pipe over the jar's frame limit
+/// (16 MiB) into a jarred tab must leave the tab's input working, as it does
+/// without a jar. At the pin the frame is refused by the outbox, the tab's
+/// input writer thread ends on the error, and nothing typed afterwards
+/// reaches the program.
+#[test]
+fn review_c_a_pipe_over_the_frame_limit_leaves_the_tabs_input_working() {
+    let dir = short_dir();
+    let place = place_in(dir.path(), built_jar());
+    let mut host = spawn_in(
+        &place,
+        "stty -echo; printf ready; exec grep --line-buffered -x end",
+        dir.path(),
+    )
+    .unwrap();
+    read_until(&host, "ready");
+    let line = [vec![b'a'; 99], vec![b'\n']].concat();
+    let payload = line.repeat(170_000);
+    assert!(payload.len() > proto::MAX_FRAME, "premise: over the frame limit");
+    let piped = host.write_confirmed_pipe(payload);
+    eprintln!("the pipe: {piped:?}");
+    let accepted = after_the_pipe(&mut host);
+    accepted.expect("input after a large pipe is still accepted");
+    read_until(&host, "end");
+    host.shutdown(END);
+}
+
+/// The control: the same pipe and the same key, with no jar.
+#[test]
+fn review_c_control_a_pipe_over_the_frame_limit_without_a_jar() {
+    let dir = short_dir();
+    let mut host = PtyHost::spawn(crate::pane::pty_host::PtySpec {
+        project_env: &[],
+        command: "stty -echo; printf ready; exec grep --line-buffered -x end",
+        rows: 24,
+        cols: 80,
+        cwd: dir.path(),
+        env: &[],
+        term: "dumb",
+        nudge_winch: false,
+        debug_dump: false,
+        exec_replace: false,
+        capture_launch_env: false,
+        jar: None,
+    })
+    .unwrap();
+    read_until(&host, "ready");
+    let line = [vec![b'a'; 99], vec![b'\n']].concat();
+    let payload = line.repeat(170_000);
+    host.write_confirmed_pipe(payload).unwrap();
+    after_the_pipe(&mut host).unwrap();
+    read_until(&host, "end");
+    host.shutdown(END);
+}
+
+/// Type `end` once the pipe has left the input queue, which takes nothing
+/// else while it's there: the answer to the first try it isn't full for.
+fn after_the_pipe(host: &mut PtyHost) -> anyhow::Result<()> {
+    let until = Instant::now() + Duration::from_secs(30);
+    loop {
+        match host.write_all(b"end\n") {
+            Err(e) if e.to_string().contains("queue full") && Instant::now() < until => {
+                std::thread::sleep(Duration::from_millis(20));
+            }
+            other => return other,
+        }
+    }
+}
