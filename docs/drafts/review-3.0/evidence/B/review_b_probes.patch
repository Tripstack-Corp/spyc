+/// The count across an upgrade, many times over, dumping the text around any
+/// break: is a line lost, or garbled?
+#[test]
+#[ignore = "review probe"]
+fn upgrade_count_diag() {
+    let rounds: usize = std::env::var("DIAG_ROUNDS").ok().and_then(|s| s.parse().ok()).unwrap_or(5);
+    let par: usize = std::env::var("DIAG_PAR").ok().and_then(|s| s.parse().ok()).unwrap_or(8);
+    let out = std::env::var("DIAG_OUT").unwrap_or_else(|_| "/dev/stdout".into());
+    let hs: Vec<_> = (0..par)
+        .map(|w| {
+            let out = out.clone();
+            std::thread::spawn(move || {
+                let mut breaks = 0;
+                for r in 0..rounds {
+                    if let Some(d) = one_upgrade_round() {
+                        breaks += 1;
+                        let mut f = std::fs::OpenOptions::new().append(true).create(true).open(&out).unwrap();
+                        let _ = writeln!(f, "worker {w} round {r}: {d}");
+                    }
+                }
+                breaks
+            })
+        })
+        .collect();
+    let breaks: usize = hs.into_iter().map(|h| h.join().unwrap_or(1000)).sum();
+    println!("DIAG: {breaks} broken counts in {} rounds", rounds * par);
+}
+
+fn one_upgrade_round() -> Option<String> {
+    let counter = "(i=0; while :; do i=$((i+1)); echo n=$i; sleep 0.005; done) & while read l; do echo got=$l; done";
+    let j = jar(&[], &["/bin/sh", "-c", counter], None);
+    let mut o = owner(&j);
+    let (mut rd, _) = Client::connect(&j.socket, Role::Reader, Duration::from_secs(10), TOKEN).expect("reader");
+    rd.send(&Msg::Replay { from: 0 }).unwrap();
+    let rstop = Arc::new(AtomicBool::new(false));
+    let rs = Arc::clone(&rstop);
+    let rh = std::thread::spawn(move || {
+        while !rs.load(Ordering::SeqCst) {
+            if rd.recv(Duration::from_millis(200)).is_err() {
+                break;
+            }
+        }
+    });
+    let _reader = scopeguard_stop(rstop, rh);
+    o.send(&Msg::Replay { from: 0 }).unwrap();
+    let next = j.socket.parent().unwrap().join("jar-next");
+    std::fs::copy(env!("CARGO_BIN_EXE_spyc-jar"), &next).unwrap();
+    let mut text: Vec<u8> = Vec::new();
+    let mut marks: Vec<(usize, String)> = Vec::new();
+    let mut next_off: Option<u64> = None;
+    let t0 = Instant::now();
+    let mut asked = false;
+    let mut upgraded = false;
+    let mut typed = false;
+    while t0.elapsed() < Duration::from_secs(60) {
+        let Ok(m) = o.recv(Duration::from_millis(200)) else {
+            return Some("connection lost".into());
+        };
+        let Some(m) = m else { continue };
+        match m {
+            Msg::Output { offset, bytes } => {
+                if let Some(n) = next_off
+                    && n != offset
+                {
+                    return Some(format!("offset jump {n} -> {offset}"));
+                }
+                next_off = Some(offset + bytes.len() as u64);
+                text.extend_from_slice(&bytes);
+                let _ = o.send(&Msg::Ack { offset: offset + bytes.len() as u64 });
+            }
+            other => marks.push((text.len(), format!("{other:?} at {:?}", t0.elapsed()))),
+        }
+        let s = String::from_utf8_lossy(&text);
+        let counts: Vec<u64> = s.lines().filter_map(|l| l.trim().strip_prefix("n=")?.parse().ok()).collect();
+        if !asked && counts.last().is_some_and(|n| *n >= 30) {
+            marks.push((text.len(), format!("asked upgrade at {:?}", t0.elapsed())));
+            o.send(&Msg::Upgrade { binary: next.display().to_string() }).unwrap();
+            asked = true;
+        }
+        if asked && !upgraded && marks.iter().any(|(_, k)| k.starts_with("Upgraded")) {
+            upgraded = true;
+        }
+        if upgraded && !typed {
+            marks.push((text.len(), format!("typed after at {:?}", t0.elapsed())));
+            o.send(&Msg::Input { bytes: b"after\n".to_vec() }).unwrap();
+            typed = true;
+        }
+        if typed && s.contains("got=after") && counts.last().is_some_and(|n| *n >= 120) {
+            for w in counts.windows(2) {
+                if w[1] != w[0] + 1 {
+                    let needle = format!("n={}", w[0]);
+                    let at = s.find(&needle).unwrap_or(0);
+                    let lo = at.saturating_sub(40);
+                    let hi = (at + 160).min(s.len());
+                    return Some(format!(
+                        "count {} then {}: text {:?}; marks {:?}",
+                        w[0],
+                        w[1],
+                        &s[lo..hi],
+                        marks.iter().map(|(p, k)| format!("@{p}:{k}")).collect::<Vec<_>>()
+                    ));
+                }
+            }
+            return None;
+        }
+    }
+    Some(format!("timed out; marks {marks:?}"))
+}
+
+struct StopOnDrop(Arc<AtomicBool>, Option<std::thread::JoinHandle<()>>);
+impl Drop for StopOnDrop {
+    fn drop(&mut self) {
+        self.0.store(true, Ordering::SeqCst);
+        if let Some(h) = self.1.take() {
+            let _ = h.join();
+        }
+    }
+}
+fn scopeguard_stop(a: Arc<AtomicBool>, h: std::thread::JoinHandle<()>) -> StopOnDrop {
+    StopOnDrop(a, Some(h))
+}
