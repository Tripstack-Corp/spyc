+/// V8: ten idle jars, five with an owner pinging every 2 s, five ownerless.
+/// Writes "jar_pid owned|ownerless" lines to $PROBE_OUT and holds them for
+/// $PROBE_SECS (default 40) while wakeups are counted outside.
+#[test]
+#[ignore = "review probe"]
+fn v8_idle_jars() {
+    let secs: u64 = std::env::var("PROBE_SECS").ok().and_then(|s| s.parse().ok()).unwrap_or(40);
+    let out = std::env::var("PROBE_OUT").unwrap_or_else(|_| "/dev/stdout".into());
+    let mut jars = Vec::new();
+    let mut owners = Vec::new();
+    let mut lines = String::new();
+    for i in 0..10 {
+        let j = jar(&[], &["/bin/sleep", "100000"], None);
+        let o = owner(&j);
+        if i < 5 {
+            let (mut rx, tx) = o.split_queued(Duration::from_secs(2), Duration::from_secs(20)).unwrap();
+            tx.send(&Msg::Replay { from: 0 }).unwrap();
+            let stop = Arc::new(AtomicBool::new(false));
+            let s2 = Arc::clone(&stop);
+            let tx2 = tx.clone();
+            let h = std::thread::spawn(move || {
+                while !s2.load(Ordering::SeqCst) {
+                    if let Ok(Some(Msg::Output { offset, bytes })) = rx.recv(Duration::from_secs(2)) {
+                        let _ = tx2.send(&Msg::Ack { offset: offset + bytes.len() as u64 });
+                    }
+                }
+            });
+            owners.push((stop, h, tx));
+            lines += &format!("{} owned\n", j.child.id());
+        } else {
+            o.drop_connection();
+            lines += &format!("{} ownerless\n", j.child.id());
+        }
+        jars.push(j);
+    }
+    std::fs::write(&out, &lines).unwrap();
+    std::thread::sleep(Duration::from_secs(secs));
+    for (stop, h, tx) in owners {
+        stop.store(true, Ordering::SeqCst);
+        tx.close();
+        let _ = h.join();
+    }
+}
