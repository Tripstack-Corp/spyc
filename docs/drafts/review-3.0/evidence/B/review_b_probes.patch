+/// H4: throughput of 'yes' to an owner that acknowledges as it reads, and
+/// the owner's ping round trip, with 0 and then 5 readers, and while a new
+/// reader replays the whole ring.
+#[test]
+#[ignore = "review probe"]
+fn h4_throughput_and_latency() {
+    for readers in [0usize, 5] {
+        let j = jar(&[], &["yes", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"], None);
+        let stop = Arc::new(AtomicBool::new(false));
+        let mut hs = Vec::new();
+        let rbytes = Arc::new(AtomicU64::new(0));
+        for _ in 0..readers {
+            let (mut r, _) = Client::connect(&j.socket, Role::Reader, Duration::from_secs(5), TOKEN).unwrap();
+            r.send(&Msg::Replay { from: 0 }).unwrap();
+            let (s, rb) = (Arc::clone(&stop), Arc::clone(&rbytes));
+            hs.push(std::thread::spawn(move || {
+                while !s.load(Ordering::SeqCst) {
+                    match r.recv(Duration::from_millis(100)) {
+                        Ok(Some(Msg::Output { bytes, .. })) => {
+                            rb.fetch_add(bytes.len() as u64, Ordering::Relaxed);
+                        }
+                        Err(_) => break,
+                        _ => {}
+                    }
+                }
+            }));
+        }
+        let mut o = owner(&j);
+        o.send(&Msg::Replay { from: 0 }).unwrap();
+        let (bytes, rtts) = drive(&mut o, Duration::from_secs(4), None);
+        println!(
+            "H4 readers={readers}: owner {:.1} MB/s, readers total {:.1} MB/s, ping rtt ms {}",
+            bytes as f64 / 4e6,
+            rbytes.load(Ordering::Relaxed) as f64 / 4e6,
+            summary(&rtts)
+        );
+        // A late reader replaying the ring while the owner reads on.
+        let (mut late, _) = Client::connect(&j.socket, Role::Reader, Duration::from_secs(5), TOKEN).unwrap();
+        late.send(&Msg::Replay { from: 0 }).unwrap();
+        let lb = Arc::new(AtomicU64::new(0));
+        let (s, lb2) = (Arc::clone(&stop), Arc::clone(&lb));
+        hs.push(std::thread::spawn(move || {
+            while !s.load(Ordering::SeqCst) {
+                match late.recv(Duration::from_millis(100)) {
+                    Ok(Some(Msg::Output { bytes, .. })) => {
+                        lb2.fetch_add(bytes.len() as u64, Ordering::Relaxed);
+                    }
+                    Err(_) => break,
+                    _ => {}
+                }
+            }
+        }));
+        let (bytes, rtts) = drive(&mut o, Duration::from_secs(4), None);
+        println!(
+            "H4 readers={readers} + replaying reader: owner {:.1} MB/s, late reader got {:.1} MB, ping rtt ms {}",
+            bytes as f64 / 4e6,
+            lb.load(Ordering::Relaxed) as f64 / 1e6,
+            summary(&rtts)
+        );
+        stop.store(true, Ordering::SeqCst);
+        drop(o);
+        drop(j);
+        for h in hs {
+            let _ = h.join();
+        }
+    }
+}
+
+/// Read and acknowledge for 'for_', pinging every 50 ms: bytes read and each
+/// ping's round trip.
+fn drive(o: &mut Client, for_: Duration, _unused: Option<()>) -> (u64, Vec<Duration>) {
+    let t0 = Instant::now();
+    let mut bytes = 0u64;
+    let mut rtts = Vec::new();
+    let mut n = 1u64;
+    let mut sent: Option<(u64, Instant)> = None;
+    while t0.elapsed() < for_ {
+        if sent.is_none() {
+            o.send(&Msg::Ping { n }).unwrap();
+            sent = Some((n, Instant::now()));
+            n += 1;
+        }
+        match o.recv(Duration::from_millis(50)) {
+            Ok(Some(Msg::Output { offset, bytes: b })) => {
+                bytes += b.len() as u64;
+                o.send(&Msg::Ack { offset: offset + b.len() as u64 }).unwrap();
+            }
+            Ok(Some(Msg::Pong { n: got })) => {
+                if let Some((want, at)) = sent
+                    && want == got
+                {
+                    rtts.push(at.elapsed());
+                    sent = None;
+                }
+            }
+            Ok(_) => {}
+            Err(e) => panic!("owner lost: {e:#}"),
+        }
+    }
+    (bytes, rtts)
+}
+
+fn summary(v: &[Duration]) -> String {
+    if v.is_empty() {
+        return "none".into();
+    }
+    let mut ms: Vec<f64> = v.iter().map(|d| d.as_secs_f64() * 1e3).collect();
+    ms.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    let p = |q: f64| ms[((ms.len() - 1) as f64 * q) as usize];
+    format!("n={} p50={:.1} p99={:.1} max={:.1}", ms.len(), p(0.5), p(0.99), ms[ms.len() - 1])
+}
+
+/// Resource hygiene: the ring's cap counts payload bytes only. A program that
+/// prints a byte at a time fills it with one event per byte.
+#[test]
+#[ignore = "review probe"]
+fn ring_memory_with_one_byte_events() {
+    let rss = |pid: u32| -> u64 {
+        let out = Command::new("ps").args(["-o", "rss=", "-p", &pid.to_string()]).output().unwrap();
+        String::from_utf8_lossy(&out.stdout).trim().parse().unwrap_or(0)
+    };
+    let held = |s: &Path| -> u64 {
+        field(s, "log").split(' ').next().and_then(|n| n.parse().ok()).unwrap_or(0)
+    };
+    let cap: u64 = 1 << 20;
+    for (name, argv) in [
+        ("large writes", vec!["/bin/sh", "-c", "yes | head -c 3000000; exec sleep 1000"]),
+        (
+            "one byte per write",
+            vec![
+                "/usr/bin/env",
+                "python3",
+                "-c",
+                "import os,time\nfor i in range(3000000):\n os.write(1,b'x')\n if i % 64 == 0: time.sleep(0.0002)\ntime.sleep(1000)",
+            ],
+        ),
+    ] {
+        let ring = cap.to_string();
+        let j = jar(&["--ring", &ring, "--window", "65536"], &argv, None);
+        let base = rss(j.child.id());
+        let t0 = Instant::now();
+        while held(&j.socket) < cap * 99 / 100 && t0.elapsed() < Duration::from_secs(240) {
+            std::thread::sleep(Duration::from_millis(500));
+        }
+        println!(
+            "RING [{name}]: ring {cap} B, held {} B after {:?}; jar RSS {} KiB at start, {} KiB now; log: {}",
+            held(&j.socket),
+            t0.elapsed(),
+            base,
+            rss(j.child.id()),
+            field(&j.socket, "log")
+        );
+    }
+}
+
+/// How long a new owner waits between its Replay and the first byte of a log
+/// that is already full: a wake lost between the writer's look at its cursor
+/// and its wait costs it the writer's 500 ms tick.
+#[test]
+#[ignore = "review probe"]
+fn replay_to_first_output_latency() {
+    let j = jar(&[], &["/bin/sh", "-c", "echo ready; exec sleep 1000"], None);
+    let mut lat = Vec::new();
+    for _ in 0..200 {
+        let mut o = owner(&j);
+        let t = Instant::now();
+        o.send(&Msg::Replay { from: 0 }).unwrap();
+        loop {
+            if let Ok(Some(Msg::Output { .. })) = o.recv(Duration::from_secs(2)) {
+                lat.push(t.elapsed());
+                break;
+            }
+            assert!(t.elapsed() < Duration::from_secs(3), "no output");
+        }
+        o.drop_connection();
+        let until = Instant::now() + Duration::from_secs(5);
+        while !field(&j.socket, "owner").starts_with("none") && Instant::now() < until {
+            std::thread::sleep(Duration::from_millis(5));
+        }
+    }
+    let slow = lat.iter().filter(|d| **d > Duration::from_millis(400)).count();
+    println!("REPLAY latency over {} owners: {} ; over 400 ms: {slow}", lat.len(), summary(&lat));
+}
