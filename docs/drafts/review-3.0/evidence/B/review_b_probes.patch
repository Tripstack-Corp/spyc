+//! Unit B (pre-3.0 review) probes: uncommitted evidence, not part of the suite.
+//! Run one at a time: cargo test --test review_b_probes -- --ignored --nocapture NAME
+//! Every jar lives in a fresh 0700 directory under /tmp and is ended, with its
+//! program's group, when the probe ends.
+
+use std::io::Write;
+use std::path::{Path, PathBuf};
+use std::process::{Child, Command, Stdio};
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::time::{Duration, Instant};
+
+use spyc_jar::client::Client;
+use spyc_jar::proto::{Msg, Role};
+
+const TOKEN: &[u8] = b"review-b-token-0123456789";
+
+struct J {
+    _dir: tempfile::TempDir,
+    socket: PathBuf,
+    child: Child,
+}
+
+fn sock_dir() -> tempfile::TempDir {
+    use std::os::unix::fs::PermissionsExt;
+    tempfile::Builder::new()
+        .prefix("revb")
+        .permissions(std::fs::Permissions::from_mode(0o700))
+        .tempdir_in("/tmp")
+        .expect("tempdir")
+}
+
+fn jar(extra: &[&str], argv: &[&str], exit_linger: Option<Duration>) -> J {
+    let dir = sock_dir();
+    let socket = dir.path().join("j.sock");
+    let mut child = Command::new(env!("CARGO_BIN_EXE_spyc-jar"))
+        .args(["--wire", "1"])
+        .args(extra)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::null())
+        .stderr(Stdio::null())
+        .spawn()
+        .expect("spawn jar");
+    let start = spyc_jar::cli::Start {
+        token: TOKEN.to_vec(),
+        socket: socket.clone(),
+        cwd: None,
+        rows: 24,
+        cols: 80,
+        hold: None,
+        exit_linger,
+        argv: argv.iter().map(|a| (*a).to_string()).collect(),
+    };
+    child.stdin.take().unwrap().write_all(&start.encode()).unwrap();
+    let until = Instant::now() + Duration::from_secs(10);
+    while !socket.exists() {
+        assert!(Instant::now() < until, "no socket");
+        std::thread::sleep(Duration::from_millis(10));
+    }
+    J { _dir: dir, socket, child }
+}
+
+fn field(socket: &Path, key: &str) -> String {
+    spyc_jar::client::describe(socket)
+        .map(|f| f.into_iter().find(|(k, _)| k == key).map(|(_, v)| v).unwrap_or_default())
+        .unwrap_or_default()
+}
+
+impl Drop for J {
+    fn drop(&mut self) {
+        if let Ok(pid) = field(&self.socket, "program_pid").parse::<i32>()
+            && let Some(p) = rustix::process::Pid::from_raw(pid)
+        {
+            let _ = rustix::process::kill_process_group(p, rustix::process::Signal::KILL);
+        }
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+    }
+}
+
+fn owner(j: &J) -> Client {
+    Client::connect(&j.socket, Role::Owner, Duration::from_secs(10), TOKEN).expect("owner").0
+}
+
+/// H1: the program ends while a process it started keeps the PTY open. The jar
+/// records the exit at once, and describes it, but never tells its owner.
+#[test]
+#[ignore = "review probe"]
+fn h1_exit_with_a_descendant_holding_the_pty_reaches_the_owner() {
+    for (name, script) in [
+        ("hup-ignoring child", "(trap '' HUP; exec sleep 20) & echo bg-started; exit 3"),
+        ("job-control shell", "set -m; sleep 20 & echo bg-started; exit 3"),
+    ] {
+        let j = jar(&[], &["/bin/sh", "-c", script], None);
+        let mut o = owner(&j);
+        o.send(&Msg::Replay { from: 0 }).unwrap();
+        let t0 = Instant::now();
+        let mut described_at = None;
+        let mut exited_at = None;
+        while t0.elapsed() < Duration::from_secs(8) {
+            if let Ok(Some(m)) = o.recv(Duration::from_millis(100)) {
+                match m {
+                    Msg::Output { offset, bytes } => {
+                        let _ = o.send(&Msg::Ack { offset: offset + bytes.len() as u64 });
+                    }
+                    Msg::Exited { .. } => {
+                        exited_at.get_or_insert(t0.elapsed());
+                    }
+                    _ => {}
+                }
+            }
+            if described_at.is_none() && field(&j.socket, "exit") == "3" {
+                described_at = Some(t0.elapsed());
+            }
+            if exited_at.is_some() && described_at.is_some() {
+                break;
+            }
+        }
+        o.send(&Msg::Signal { signal: 3 }).unwrap();
+        let mut kill_answer = None;
+        let t1 = Instant::now();
+        while t1.elapsed() < Duration::from_secs(2) && kill_answer.is_none() {
+            if let Ok(Some(m @ Msg::Refused { .. })) = o.recv(Duration::from_millis(100)) {
+                kill_answer = Some(m);
+            }
+        }
+        println!(
+            "H1 [{name}]: describe exit=3 at {described_at:?}; owner heard exited at {exited_at:?} (waited 8 s); Signal(kill) after: {kill_answer:?}; jar alive: {}",
+            j.socket.exists()
+        );
+        assert!(described_at.is_some(), "premise: the program exited");
+        assert!(exited_at.is_some(), "[{name}] the jar recorded the exit but its owner never heard it");
+    }
+}
