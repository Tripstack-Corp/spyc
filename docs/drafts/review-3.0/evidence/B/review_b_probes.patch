+/// A recv blocked on an idle jar connection, while this process is stopped
+/// and continued from outside (as a shell's ^Z / fg would). On Linux a socket
+/// read with SO_RCVTIMEO fails with EINTR after SIGCONT even with no handler.
+#[test]
+#[ignore = "review probe"]
+fn eintr_after_stop_and_continue() {
+    let j = jar(&[], &["/bin/cat"], None);
+    let mut o = owner(&j);
+    let me = std::process::id();
+    let h = std::thread::spawn(move || {
+        let t = Instant::now();
+        let r = o.recv(Duration::from_secs(6));
+        (t.elapsed(), format!("{r:?}"))
+    });
+    let _ = Command::new("/bin/sh")
+        .args(["-c", &format!("sleep 1; kill -STOP {me}; sleep 0.5; kill -CONT {me}")])
+        .spawn()
+        .unwrap();
+    let (took, r) = h.join().unwrap();
+    println!("EINTR-STOP: recv returned after {took:?}: {r}");
+}
+
+extern "C" fn noop(_: libc::c_int) {}
+
+/// A recv blocked on an idle jar connection gets a handled signal (SIGWINCH,
+/// SA_RESTART, as spyc's terminal handling installs) on its own thread.
+#[test]
+#[ignore = "review probe"]
+fn eintr_on_a_handled_signal() {
+    use std::os::unix::thread::JoinHandleExt;
+    // SAFETY: a review probe; the handler does nothing and is async-signal-safe.
+    unsafe {
+        let mut sa: libc::sigaction = std::mem::zeroed();
+        sa.sa_sigaction = noop as *const () as usize;
+        sa.sa_flags = libc::SA_RESTART;
+        libc::sigaction(libc::SIGWINCH, &sa, std::ptr::null_mut());
+    }
+    let j = jar(&[], &["/bin/cat"], None);
+    let mut o = owner(&j);
+    let h = std::thread::spawn(move || {
+        let t = Instant::now();
+        let r = o.recv(Duration::from_secs(4));
+        (t.elapsed(), format!("{r:?}"))
+    });
+    std::thread::sleep(Duration::from_millis(500));
+    // SAFETY: the thread is alive (joined below).
+    unsafe {
+        libc::pthread_kill(h.as_pthread_t() as libc::pthread_t, libc::SIGWINCH);
+    }
+    let (took, r) = h.join().unwrap();
+    println!("EINTR-WINCH: recv returned after {took:?}: {r}");
+}
